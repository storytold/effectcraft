<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="Visualab Effects" Manufacturer="Visualab Studios" Version="$(var.Version)" UpgradeCode="AACA8593-C6ED-40A8-BA6C-CB325D8529F9" Scope="perUserOrMachine" Compressed="yes" Language="1033">
    <SummaryInformation Description="Visualab Effects motion graphics and visual effects" Manufacturer="Visualab Studios" />
    <?include $(sys.SOURCEFILEDIR)install-policy.wxi?>
    <!-- Same-version upgrades let successive pre-releases of one X.Y.Z replace each other
         (MSI versions are numeric, so 1.2.3-rc.1 and 1.2.3-rc.2 are both 1.2.3). -->
    <MajorUpgrade AllowSameVersionUpgrades="yes" DowngradeErrorMessage="A newer version of Visualab Effects is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />
    <!-- The setup wizard (installer-ui.wxs): pick the folder on a fresh install. -->
    <UIRef Id="EffectcraftUI" />

    <Icon Id="EffectcraftIcon.ico" SourceFile="$(var.IconPath)" />
    <Property Id="ARPPRODUCTICON" Value="EffectcraftIcon.ico" />
    <Property Id="ARPURLINFOABOUT" Value="https://www.visualabstudios.com/apps/effectcraft" />
    <Property Id="ARPURLUPDATEINFO" Value="https://www.visualabstudios.com/apps/effectcraft" />
    <Property Id="ARPHELPLINK" Value="https://www.visualabstudios.com" />

    <!-- An upgrade, repair or silent reinstall goes where the installed copy already is: the App Paths
         "Path" value written below, or for releases before this installer change (no Path value; they
         could be put elsewhere with INSTALLFOLDER=...) the folder of the effectcraft.exe that App Paths names. A
         "file" search with no FileSearch inside yields that file's folder. A folder passed on the
         command line (INSTALLFOLDER=...) wins. -->
    <Property Id="PREVIOUSINSTALLFOLDER" Secure="yes">
      <RegistrySearch Id="PreviousInstallFolder" Root="HKLM" Type="directory" Key="Software\Microsoft\Windows\CurrentVersion\App Paths\effectcraft.exe" Name="Path" />
    </Property>
    <Property Id="PREVIOUSEXEFOLDER" Secure="yes">
      <RegistrySearch Id="PreviousExeFolder" Root="HKLM" Type="file" Key="Software\Microsoft\Windows\CurrentVersion\App Paths\effectcraft.exe" />
    </Property>
    <!-- The desktop shortcut: on by default for a fresh install (a box in the wizard, or
         DESKTOPSHORTCUT=0 silently); an upgrade keeps what the installed copy chose, and adds none
         to an install from before this option. -->
    <Property Id="DESKTOPSHORTCUT" Value="1" Secure="yes" />
    <Property Id="PREVIOUSDESKTOPSHORTCUT" Secure="yes">
      </Property>
    <SetProperty Id="DESKTOPSHORTCUT" Value="[PREVIOUSDESKTOPSHORTCUT]" After="CraftLoadOption1U" Sequence="both" Condition="WIX_UPGRADE_DETECTED" />

    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="CraftSuiteFolder" Name="Visualab">
        <Directory Id="INSTALLFOLDER" Name="Visualab Effects" />
      </Directory>
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder" />
    <StandardDirectory Id="DesktopFolder" />

    <Feature Id="Main" Title="Visualab Effects" Level="1">
      <ComponentGroupRef Id="EffectcraftFiles" />
    </Feature>
  <Property Id="CRAFT_OPTION_1_M" Secure="yes"><RegistrySearch Id="CRAFT_OPTION_1_MSearch" Root="HKLM" Type="raw" Key="Software\Visualab Effects" Name="DesktopShortcut" />
    </Property><SetProperty Id="PREVIOUSDESKTOPSHORTCUT" Action="CraftLoadOption1M" Value="[CRAFT_OPTION_1_M]" After="LaunchConditions" Sequence="both" Condition="ALLUSERS = 1" /><Property Id="CRAFT_OPTION_1_U" Secure="yes"><RegistrySearch Id="CRAFT_OPTION_1_USearch" Root="HKCU" Type="raw" Key="Software\Visualab Effects" Name="DesktopShortcut" />
    </Property><SetProperty Id="PREVIOUSDESKTOPSHORTCUT" Action="CraftLoadOption1U" Value="[CRAFT_OPTION_1_U]" After="CraftLoadOption1M" Sequence="both" Condition="ALLUSERS &lt;&gt; 1" /></Package>

  <Fragment>
    <ComponentGroup Id="EffectcraftFiles" Directory="INSTALLFOLDER">
      <Component Id="EffectcraftNotice">
        <File Id="EffectcraftNoticeFile" Source="$(var.BinDir)\NOTICE" KeyPath="yes" />
      </Component>
      <Component Id="EffectcraftApp" Guid="BA719860-95FE-4154-B265-47006B8E9083">
        <File Id="EffectcraftExe" Source="$(var.BinDir)\effectcraft.exe" KeyPath="yes">
          <Shortcut Id="StartMenuShortcut" Directory="ProgramMenuFolder" Name="Visualab Effects" Description="Visualab Effects motion graphics and visual effects" WorkingDirectory="INSTALLFOLDER" Advertise="yes" Icon="EffectcraftIcon.ico" IconIndex="0" />
        </File>

        <RegistryValue Root="HKMU" Key="Software\Microsoft\Windows\CurrentVersion\App Paths\effectcraft.exe" Value="[#EffectcraftExe]" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Microsoft\Windows\CurrentVersion\App Paths\effectcraft.exe" Name="Path" Value="[INSTALLFOLDER]" Type="string" />
        <!-- The desktop shortcut choice, for the next upgrade (empty: none). -->
        <RegistryValue Root="HKMU" Key="Software\Visualab Effects" Name="DesktopShortcut" Value="[DESKTOPSHORTCUT]" Type="string" />
      <RegistryValue Root="HKMU" Key="Software\Visualab Effects" Name="InstallDir" Value="[INSTALLFOLDER]" Type="string" />
      </Component>

      <Component Id="EffectcraftCli">
        <File Id="EffectcraftCliExe" Source="$(var.BinDir)\effectcraft-cli.exe" KeyPath="yes" />
      </Component>

      <!-- A component under the user's profile folders needs an HKCU key path (ICE38, ICE43). -->
      <Component Id="DesktopShortcut" Directory="DesktopFolder" Condition="DESKTOPSHORTCUT = &quot;1&quot;">
        <Shortcut Id="DesktopShortcut" Name="Visualab Effects" Description="Visualab Effects motion graphics and visual effects" Target="[#EffectcraftExe]" WorkingDirectory="INSTALLFOLDER" Icon="EffectcraftIcon.ico" IconIndex="0" />
        <RegistryValue Root="HKMU" Key="Software\Visualab Effects" Name="DesktopShortcut" Value="1" Type="string" KeyPath="yes" />
      </Component>
    </ComponentGroup>
  </Fragment>
</Wix>
