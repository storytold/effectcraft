<?xml version="1.0" encoding="utf-8"?>
<!--
  EffectCraft MSI (WiX Toolset v5: `dotnet tool install -g wix`). Built by package.ps1:

    wix build effectcraft.wxs -arch x64 -d Version=1.2.3 -d BinDir=... -d IconPath=... -o out.msi

  Per-machine install into Program Files, a Start Menu shortcut, `.pcraft` owned by EffectCraft,
  and EffectCraft offered under "Open with" for PSD/PSB and the image formats it reads (without
  taking over the user's default app for them).
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <?ifndef StaticDxc ?>
    <?define StaticDxc = 0 ?>
  <?endif ?>
  <Package
      Name="EffectCraft"
      Manufacturer="Learning Machines LLC"
      Version="$(var.Version)"
      UpgradeCode="AACA8593-C6ED-40A8-BA6C-CB325D8529F9"
      Scope="perMachine"
      Compressed="yes"
      Language="1033">
    <SummaryInformation Description="EffectCraft motion graphics and visual effects" Manufacturer="Learning Machines LLC" />
    <!-- Same-version upgrades let successive pre-releases of one X.Y.Z replace each other
         (MSI versions are numeric, so 1.2.3-rc.1 and 1.2.3-rc.2 are both 1.2.3). -->
    <MajorUpgrade AllowSameVersionUpgrades="yes"
        DowngradeErrorMessage="A newer version of EffectCraft is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <Icon Id="EffectcraftIcon.ico" SourceFile="$(var.IconPath)" />
    <Property Id="ARPPRODUCTICON" Value="EffectcraftIcon.ico" />
    <Property Id="ARPURLINFOABOUT" Value="https://getartcraft.com/apps/effectcraft" />
    <Property Id="ARPURLUPDATEINFO" Value="https://getartcraft.com/apps/effectcraft" />
    <Property Id="ARPHELPLINK" Value="https://discord.gg/artcraft" />

    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="INSTALLFOLDER" Name="EffectCraft">
        <?if $(var.StaticDxc) = 1 ?>
          <Directory Id="LicensesFolder" Name="licenses">
            <Directory Id="StaticDxcLicensesFolder" Name="static-dxc" />
          </Directory>
        <?endif ?>
      </Directory>
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder" />

    <Feature Id="Main" Title="EffectCraft" Level="1">
      <ComponentGroupRef Id="EffectcraftFiles" />
      <?if $(var.StaticDxc) = 1 ?>
        <ComponentGroupRef Id="StaticDxcNotices" />
      <?endif ?>
    </Feature>
  </Package>

  <Fragment>
    <ComponentGroup Id="EffectcraftFiles" Directory="INSTALLFOLDER">
      <Component Id="EffectcraftApp" Guid="BA719860-95FE-4154-B265-47006B8E9083">
        <File Id="EffectcraftExe" Source="$(var.BinDir)\effectcraft.exe" KeyPath="yes">
          <Shortcut Id="StartMenuShortcut" Directory="ProgramMenuFolder" Name="EffectCraft"
              Description="EffectCraft motion graphics and visual effects" WorkingDirectory="INSTALLFOLDER" Advertise="yes"
              Icon="EffectcraftIcon.ico" IconIndex="0" />
        </File>

        <RegistryValue Root="HKLM" Key="Software\Microsoft\Windows\CurrentVersion\App Paths\effectcraft.exe" Value="[#EffectcraftExe]" Type="string" />
      </Component>

      <Component Id="EffectcraftCli">
        <File Id="EffectcraftCliExe" Source="$(var.BinDir)\effectcraft-cli.exe" KeyPath="yes" />
      </Component>
      <Component Id="EffectcraftNotice">
        <File Id="EffectcraftNoticeFile" Source="$(var.BinDir)\NOTICE" KeyPath="yes" />
      </Component>
    </ComponentGroup>
    <?if $(var.StaticDxc) = 1 ?>
      <ComponentGroup Id="StaticDxcNotices" Directory="StaticDxcLicensesFolder">
        <Component Id="StaticDxcProvenance">
          <File Id="StaticDxcProvenanceFile" Source="$(var.BinDir)\licenses\static-dxc\PROVENANCE.md" KeyPath="yes" />
        </Component>
        <Component Id="StaticDxcWrapperLicense">
          <File Id="StaticDxcWrapperLicenseFile" Source="$(var.BinDir)\licenses\static-dxc\mach-dxcompiler-rs-LICENSE.txt" KeyPath="yes" />
        </Component>
        <Component Id="StaticDxcIntegrationTerms">
          <File Id="StaticDxcIntegrationTermsFile" Source="$(var.BinDir)\licenses\static-dxc\mach-dxcompiler-LICENSE.txt" KeyPath="yes" />
        </Component>
        <Component Id="StaticDxcIntegrationLicense">
          <File Id="StaticDxcIntegrationLicenseFile" Source="$(var.BinDir)\licenses\static-dxc\mach-dxcompiler-LICENSE-MIT.txt" KeyPath="yes" />
        </Component>
        <Component Id="StaticDxcCompilerLicense">
          <File Id="StaticDxcCompilerLicenseFile" Source="$(var.BinDir)\licenses\static-dxc\DirectXShaderCompiler-LICENSE.TXT" KeyPath="yes" />
        </Component>
        <Component Id="StaticDxcCompilerNotices">
          <File Id="StaticDxcCompilerNoticesFile" Source="$(var.BinDir)\licenses\static-dxc\DirectXShaderCompiler-ThirdPartyNotices.txt" KeyPath="yes" />
        </Component>
      </ComponentGroup>
    <?endif ?>
  </Fragment>
</Wix>
